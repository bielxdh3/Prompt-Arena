{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Prompt Arena",
  "version": "0.1.3",
  "identifier": "com.promptarena.desktop",
  "mainBinaryName": "prompt-arena",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run prepare:worker-sidecar && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Prompt Arena",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:1420 ws://localhost:1420 ipc: http://ipc.localhost; img-src 'self' asset: https://asset.localhost data:; style-src 'self'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "targets": ["nsis", "msi", "deb", "appimage"],
    "externalBin": ["binaries/prompt-arena-worker"],
    "publisher": "Prompt Arena contributors",
    "category": "DeveloperTool",
    "shortDescription": "Local-first model comparison laboratory",
    "longDescription": "Prompt Arena is a local-first desktop workspace for repeatable model comparisons and auditable evidence.",
    "copyright": "Copyright © 2026 Prompt Arena contributors",
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "Prompt Arena"
      },
      "wix": {
        "upgradeCode": "8f8b4c7d-3f0a-4f76-9c2e-6a5c9d2b1e40"
      }
    }
  }
}
