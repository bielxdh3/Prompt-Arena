{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prompt-arena.local/schemas/benchmark-v1.schema.json",
  "title": "Prompt Arena Benchmark Document v1",
  "description": "Checked-in benchmark contract/reference. Phase 02 enforces it with serde and deterministic manual validation; no JSON Schema engine is required at runtime.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "kind", "pack", "benchmark", "benchmarkVersion"],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "benchmark"},
    "pack": {"$ref": "#/$defs/pack"},
    "benchmark": {"$ref": "#/$defs/benchmark"},
    "benchmarkVersion": {"$ref": "#/$defs/benchmarkVersion"}
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "versionIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,128}@[1-9][0-9]*$"
    },
    "portableRelativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(^|/)(\\.|\\.\\.)(/|$))(?!.*/$).+$"
    },
    "nonEmptyString": {"type": "string", "minLength": 1},
    "pack": {
      "type": "object",
      "additionalProperties": true,
      "required": ["packId", "name", "categories"],
      "properties": {
        "packId": {"$ref": "#/$defs/identifier"},
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "description": {"type": ["string", "null"]},
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/category"}
        }
      }
    },
    "category": {
      "type": "object",
      "additionalProperties": true,
      "required": ["categoryId", "name"],
      "properties": {
        "categoryId": {"$ref": "#/$defs/identifier"},
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "children": {"type": "array", "items": {"$ref": "#/$defs/category"}}
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": true,
      "required": ["benchmarkId", "name"],
      "properties": {
        "benchmarkId": {"$ref": "#/$defs/identifier"},
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "description": {"type": ["string", "null"]}
      }
    },
    "benchmarkVersion": {
      "type": "object",
      "additionalProperties": true,
      "required": ["versionId", "versionNumber", "tasks", "rubrics", "defaultRepetitions"],
      "properties": {
        "versionId": {"$ref": "#/$defs/versionIdentifier"},
        "versionNumber": {"type": "integer", "minimum": 1},
        "defaultRepetitions": {"type": "integer", "minimum": 1},
        "tasks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/task"}},
        "rubrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rubric"}}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": true,
      "required": ["taskId", "name", "prompt", "cases"],
      "properties": {
        "taskId": {"$ref": "#/$defs/identifier"},
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "prompt": {"$ref": "#/$defs/nonEmptyString"},
        "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}},
        "rubricId": {"$ref": "#/$defs/identifier"},
        "difficulty": {"type": "integer", "minimum": 1, "maximum": 5},
        "systemPrompt": {"type": ["string", "null"]},
        "context": {"type": ["string", "null"]}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": true,
      "required": ["caseId", "artifacts"],
      "properties": {
        "caseId": {"$ref": "#/$defs/identifier"},
        "prompt": {"type": ["string", "null"]},
        "expected": {},
        "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}}
      }
    },
    "rubric": {
      "type": "object",
      "additionalProperties": true,
      "required": ["rubricId", "name", "criteria"],
      "properties": {
        "rubricId": {"$ref": "#/$defs/identifier"},
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "criteria": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterion"}}
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": true,
      "required": ["criterionId", "name", "weight"],
      "properties": {
        "criterionId": {"$ref": "#/$defs/identifier"},
        "name": {"$ref": "#/$defs/nonEmptyString"},
        "description": {"type": ["string", "null"]},
        "weight": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": true,
      "required": ["artifactId", "relativePath", "schemaVersion"],
      "properties": {
        "artifactId": {"$ref": "#/$defs/identifier"},
        "relativePath": {"$ref": "#/$defs/portableRelativePath"},
        "schemaVersion": {"type": "integer", "minimum": 1},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$"}
      }
    }
  }
}
