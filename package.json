  "devDependencies": {
    "@tauri-apps/cli": "2.5.0",
    "@types/react": "19.0.3",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.7.3",
    "vite": "6.4.3",
    "vitest": "3.2.7"
